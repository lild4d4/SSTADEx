{
  "name": "simplecurrentsource",
  "version": "1.0",
  "description": "Simple NMOS current source — single transistor per branch",
  "transistor_type": "nmos",
  "subckt_name": "simplecurrentsource",
  "pin_order": ["VINP", "VINN", "VOUTP", "VOUTN", "VSS"],

  "small_signal": {
    "branches": [
      {
        "name": "m1",
        "vd": "VOUTP",
        "vg": "VINP",
        "vs": "VSS"
      },
      {
        "name": "m2",
        "vd": "VINP",
        "vg": "VINP",
        "vs": "VSS"
      }
    ]
  },

  "ports": {
    "VINP":  { "name": "VINP",  "role": "INPUT",  "description": "Reference gate/input" },
    "VINN":  { "name": "VINN",  "role": "INPUT",  "description": "Diode-connected drain node" },
    "VOUTP": { "name": "VOUTP", "role": "OUTPUT", "description": "Positive output" },
    "VOUTN": { "name": "VOUTN", "role": "OUTPUT", "description": "Mirrored output" },
    "VSS":   { "name": "VSS",   "role": "BIAS",   "description": "Source / ground node" }
  },

  "layout_params": [
    { "name": "W",    "unit": "m",   "computed": true,  "description": "Transistor width (set by build)" },
    { "name": "L",    "unit": "m",   "computed": false, "default": 4e-7, "description": "Gate length" },
    { "name": "nf",   "unit": "int", "computed": false, "default": 2,   "description": "Number of gate fingers" },
    { "name": "rows", "unit": "int", "computed": false, "default": 1,   "description": "Number of rows in array" }
  ],

  "lut_config": {
    "lut_w": 5e-6,
    "axes": [
      { "variable": "vds", "values": [0.1, 1.2], "type": "arange" },
      { "variable": "vgs", "values": [0.1, 1.2], "type": "arange" }
    ],
    "lengths": [4e-7, 8e-7, 1.6e-6, 3.2e-6, 6.4e-6]
  },

  "files": {
    "build":   "build.py",
    "netlist": "netlist/netlist.spice",
    "symbol":  "symbol/symbol.sym"
  }
}
