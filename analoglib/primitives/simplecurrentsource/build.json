{
  "inputs": [
    { "name": "current", "kind": "scalar", "required": true },
    { "name": "VINP", "kind": "vector", "required": true, "source": "port_voltage" },
    { "name": "VOUTP", "kind": "vector", "required": true, "source": "port_voltage" },
    { "name": "VSS", "kind": "vector", "required": true, "source": "port_voltage" }
  ],
  "sweep_mode": "cartesian",
  "derived": [
    { "name": "id_m1", "expr": "current" },
    { "name": "vds_m1", "expr": "VOUTP - VSS" },
    { "name": "vgs_m1", "expr": "VINP - VSS" }
  ],
  "lut": [
    {
      "name": "m1",
      "device": "nmos",
      "dof": {
        "vds": "vds_m1",
        "vgs": "vgs_m1"
      },
      "lengths": "$lut_config.lengths"
    }
  ],
  "columns": [
    { "name": "length", "expr": "lut.m1.length" },
    { "name": "width_m1", "expr": "id_m1 / lut.m1.jd" },
    { "name": "width_m2", "expr": "width_m1" },
    { "name": "gm", "expr": "lut.m1.gmid * id_m1" },
    { "name": "gdsid", "expr": "lut.m1.gds / lut.m1.id" },
    { "name": "gds", "expr": "gdsid * id_m1" },
    { "name": "Ro", "expr": "1 / gds" },
    { "name": "cgg", "expr": "width_m1 * lut.m1.cgg" },
    { "name": "cgs", "expr": "width_m1 * lut.m1.cgs" },
    { "name": "cgd", "expr": "width_m1 * lut.m1.cgd" },
    { "name": "vgs_cs", "expr": "vgs_m1" }
  ]
}
